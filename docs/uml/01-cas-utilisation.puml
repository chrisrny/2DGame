@startuml 01-cas-utilisation
!include style.iuml
hide <<jeu>> stereotype
title Cas d'utilisation — ce que le joueur peut faire

actor "Joueur\n(clavier + souris\nou manette)" as J
actor "Présentateur\n(soutenance)" as D
J <|-right- D

rectangle "Kagaribi" {
  usecase "Lancer une partie" as Start
  usecase "Régler les options\n(dégâts, difficulté)" as Options
  usecase "Mettre en pause" as Pause
  usecase "Jouer une partie\n2 étages + le boss" as Run <<jeu>>
  usecase "Se déplacer, viser,\nattaquer, esquiver" as Fight
  usecase "Lancer un sort\n(Onde de choc, Éventail)" as Spell
  usecase "Choisir une relique\n(1 parmi 3)" as Relic
  usecase "Affronter l'Oni\ndu quartier" as Boss
  usecase "Voir le bilan" as End
  usecase "Forcer la fin\n(F9 / F10)" as Cheat
}

J --> Start
J --> Run
J --> Pause
D --> Cheat

Run ..> Fight : <<include>>
Run ..> Boss : <<include>>
Run ..> End : <<include>>
Spell ..> Run : <<extend>>
Relic ..> Run : <<extend>>\nniveau gagné
Options ..> Pause : <<extend>>
Cheat ..> End : <<include>>
@enduml
