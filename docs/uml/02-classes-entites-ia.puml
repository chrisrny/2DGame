@startuml 02-classes-entites-ia
!include style.iuml
title Diagramme de classes — Entités, ennemis et IA\n(patterns Strategy, State, Template Method, Factory)

package "game.model.entity" {
  interface Damageable <<interface>> {
    + receive(hit : Hit) : boolean
    + isAlive() : boolean
    + hitbox() : Circle
    + faction() : Faction
  }

  class Player {
    - hp : int
    - position : Vec2
    + update(intent : PlayerIntent, world : World, dt : float) : void
    + receive(hit : Hit) : boolean
  }
  note bottom of Player : Détaillé dans le diagramme\n03-classes-joueur

  abstract class Enemy {
    - position : Vec2
    - hp : int
    - maxHp : int
    - speed : float
    - contactDamage : int
    - multiplier : float
    - stunLeft : float
    # Enemy(position, maxHp, radius, speed,\n  contactDamage, behavior : EnemyBehavior, multiplier)
    + update(world : World, dt : float) : void
    + chase(world : World, dt : float) : void
    + moveToward(target : Vec2, world : World, dt : float) : void
    + moveBy(delta : Vec2, world : World) : Vec2
    + receive(hit : Hit) : boolean
    + contactDamage() : int
    + pushResistance() : float
    + isStunned() : boolean
    # setPosition(p : Vec2) : void
    # setHp(hp : int) : void
  }

  class Prowler {
    + {static} MAX_HP : int = 30
    + Prowler(position : Vec2, multiplier : float)
  }
  class Archer {
    + {static} MAX_HP : int = 20
    + Archer(position : Vec2, multiplier : float)
  }
  class Charger {
    + {static} MAX_HP : int = 40
    + Charger(position : Vec2, multiplier : float)
    + contactDamage() : int
    + pushResistance() : float
    + isStunned() : boolean
    + isWindingUp() : boolean
  }
  class Boss {
    + {static} MAX_HP : int = 800
    + {static} SECOND_PHASE_THRESHOLD : float = 0.5
    - phaseNumber : int
    + Boss(position : Vec2, multiplier : float)
    - act(world : World, dt : float) : void
    + receive(hit : Hit) : boolean
    + contactDamage() : int
    + currentAttackTelegraph() : Optional<Telegraph>
  }
}

package "game.model.ai" {
  interface EnemyBehavior <<interface>> {
    + act(self : Enemy, world : World, dt : float) : void
  }
  class ProwlerBehavior {
    + act(self : Enemy, world : World, dt : float) : void
  }
  class ArcherBehavior {
    - fireCooldown : float
    + act(self : Enemy, world : World, dt : float) : void
    - shoot(self : Enemy, target : Vec2, world : World) : void
  }
  class ChargerBehavior {
    - phase : Phase
    - phaseTime : float
    - chargeDirection : Vec2
    + act(self : Enemy, world : World, dt : float) : void
    + isCharging() : boolean
    + isWindingUp() : boolean
  }
  enum "ChargerBehavior.Phase" as ChargerPhase <<enumeration>> {
    APPROACH
    WIND_UP
    CHARGE
    STUNNED
  }

  interface BossPhase <<interface>> {
    + update(boss : Boss, world : World, dt : float) : void
    + telegraph(boss : Boss) : Optional<Telegraph>
    + isCharging() : boolean
  }
  class BossFirstPhase {
    - stepTime : float
    - slamNext : boolean
    + update(boss : Boss, world : World, dt : float) : void
    + telegraph(boss : Boss) : Optional<Telegraph>
    # pauseDuration() : float
    # slamRadius() : float
    # slamWindUp() : float
    # chargeSpeed() : float
    # afterSlam(boss : Boss, world : World, zone : Circle) : void
  }
  class BossSecondPhase {
    # pauseDuration() : float
    # slamRadius() : float
    # slamWindUp() : float
    # chargeSpeed() : float
    # afterSlam(boss : Boss, world : World, zone : Circle) : void
  }
}

package "game.model.world" {
  interface World <<interface>> {
    + playerPosition() : Vec2
    + walls() : List<Rect>
    + solidWalls() : List<Rect>
    + targetsIn(zone : Circle, attacker : Faction) : List<Damageable>
    + spawnProjectile(p : Projectile) : void
    + events() : EventBus
  }
  class GameMap
  class EnemyFactory {
    + {static} create(type : EnemyType, position : Vec2, multiplier : float) : Enemy
  }
  enum EnemyType <<enumeration>> {
    PROWLER
    ARCHER
    CHARGER
  }
}

' --- Héritage et réalisation
Damageable <|.. Player
Damageable <|.. Enemy
Enemy <|-- Prowler
Enemy <|-- Archer
Enemy <|-- Charger
Enemy <|-- Boss

EnemyBehavior <|.. ProwlerBehavior
EnemyBehavior <|.. ArcherBehavior
EnemyBehavior <|.. ChargerBehavior
BossPhase <|.. BossFirstPhase
BossFirstPhase <|-- BossSecondPhase
World <|.. GameMap

' --- Associations
Enemy "1" *-- "1" EnemyBehavior : - behavior
Charger "1" --> "1" ChargerBehavior : - behavior
ChargerBehavior +-- ChargerPhase
Boss "1" *-- "1" BossPhase : - phase
BossFirstPhase "1" --> "0..1" ChargerBehavior : - charge
GameMap "1" *-- "0..*" Enemy : - enemies
EnemyFactory ..> Enemy : <<create>>
EnemyFactory ..> EnemyType : <<use>>
GameMap ..> EnemyFactory : <<use>>

note right of EnemyBehavior
  <b>Strategy</b> : chaque type d'ennemi reçoit son
  comportement à la construction. Enemy ne sait
  pas COMMENT il agit, il délègue à act().
  Ajouter un ennemi = une nouvelle stratégie,
  sans toucher à Enemy.
end note

note right of BossPhase
  <b>State</b> : à 50 % de ses PV, le Boss remplace
  son objet BossFirstPhase par BossSecondPhase.
  <b>Template Method</b> : BossSecondPhase ne
  réécrit que les hooks protégés (durées, rayon,
  afterSlam), l'enchaînement reste dans
  BossFirstPhase.update().
end note

note bottom of EnemyFactory
  <b>Factory</b> : GameMap fait apparaître les
  vagues à partir d'un EnemyType, sans jamais
  écrire new Prowler(...) lui-même.
end note
@enduml
