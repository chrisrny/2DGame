@startuml 03-classes-joueur
!include style.iuml
left to right direction
title Diagramme de classes — Joueur, états, compétences et reliques\n(patterns State, Template Method, Factory)

package "game.model.entity" {
  class Player {
    + {static} ATTACK_DURATION : float = 0.2
    + {static} INVULNERABILITY_DURATION : float = 0.8
    - position : Vec2
    - hp : int
    - facing : Vec2
    - attackCooldownLeft : float
    - dodgeCooldownLeft : float
    - invulnerableLeft : float
    + Player(position : Vec2, stats : PlayerStats, random : Random)
    + update(intent : PlayerIntent, world : World, dt : float) : void
    + walk(direction : Vec2, world : World, dt : float) : void
    + moveBy(delta : Vec2, world : World) : void
    + canStartDodge() : boolean
    + startDodge(move : Vec2) : DodgingState
    + canStartAttack() : boolean
    + strike(world : World) : int
    + echoStrike(world : World) : int
    + registerHit() : void
    + receive(hit : Hit) : boolean
    + addRelic(relic : Relic) : void
    + heal(amount : int) : void
    + stateKind() : PlayerStateKind
    - computeStats() : PlayerStats
  }
}

package "game.model.player.state" {
  interface PlayerState <<interface>> {
    + next(player : Player, intent : PlayerIntent) : PlayerState
    + act(player : Player, intent : PlayerIntent, world : World, dt : float) : void
    + invulnerable() : boolean
    + kind() : PlayerStateKind
  }
  class IdleState
  class MovingState
  class AttackingState {
    - elapsed : float
    - struck : boolean
  }
  class DodgingState {
    - direction : Vec2
    - elapsed : float
    - travelled : float
    + DodgingState(direction : Vec2)
    + invulnerable() : boolean
  }
  class HurtState {
    - knockback : Vec2
    - elapsed : float
    + HurtState(knockback : Vec2)
  }
  class DeadState
  enum PlayerStateKind <<enumeration>> {
    IDLE
    MOVING
    ATTACKING
    DODGING
    HURT
    DEAD
  }
}

package "game.model.skill" {
  abstract class Skill {
    - name : String
    - cooldown : float
    - cooldownLeft : float
    # Skill(name : String, cooldown : float)
    + tryActivate(player : Player, world : World) : boolean {leaf}
    # {abstract} activate(player : Player, world : World) : void
    + update(dt : float) : void
    + isReady() : boolean
    + cooldownRatio() : float
  }
  class Shockwave {
    + {static} RADIUS : float = 96
    + {static} DAMAGE : int = 28
    + {static} COOLDOWN : float = 5
    # activate(player : Player, world : World) : void
  }
  class BladeFan {
    + {static} BLADE_COUNT : int = 7
    + {static} DAMAGE : int = 9
    + {static} COOLDOWN : float = 2.5
    # activate(player : Player, world : World) : void
  }
}

package "game.model.relic" {
  interface Relic <<interface>> {
    + name() : String
    + description() : String
    + apply(stats : PlayerStats) : PlayerStats
    + onHit(player : Player) : void
    + onAttack(player : Player) : void
    + onDodge(player : Player) : void
    + update(player : Player, world : World, dt : float) : void
    + fireZones() : List<Circle>
  }
  abstract class AbstractRelic {
    - name : String
    - description : String
    # AbstractRelic(name : String, description : String)
    + name() : String {leaf}
    + description() : String {leaf}
    + apply(stats : PlayerStats) : PlayerStats
  }
  class SharpenedBlade {
    + apply(stats : PlayerStats) : PlayerStats
  }
  class AshBoots {
    + apply(stats : PlayerStats) : PlayerStats
  }
  class EmberHeart {
    + apply(stats : PlayerStats) : PlayerStats
  }
  class ShadowFeather {
    + apply(stats : PlayerStats) : PlayerStats
  }
  class HunterEye {
    + apply(stats : PlayerStats) : PlayerStats
  }
  class VampireFang {
    + onHit(player : Player) : void
  }
  class EmberStep {
    + onDodge(player : Player) : void
    + update(player : Player, world : World, dt : float) : void
    + fireZones() : List<Circle>
  }
  class Echo {
    + onAttack(player : Player) : void
    + update(player : Player, world : World, dt : float) : void
  }
  class RelicFactory {
    - RelicFactory()
    + {static} all() : List<Relic>
    + {static} draw(count : int, random : Random, owned : Collection<Relic>) : List<Relic>
  }
}

package "game.model.commun" {
  class PlayerStats <<record>> {
    + speed : float
    + maxHp : int
    + attackDamage : int
    + critChance : float
    + dodgeCooldown : float
    + withSpeed(v : float) : PlayerStats
    + withMaxHp(v : int) : PlayerStats
    + withAttackDamage(v : int) : PlayerStats
    + withCritChance(v : float) : PlayerStats
    + withDodgeCooldown(v : float) : PlayerStats
  }
}

' --- Joueur
Player "1" *-- "1" PlayerState : - state
Player "1" *-- "2" Skill : - skill1, skill2
Player "1" o-- "0..*" Relic : - relics
Player --> "2" PlayerStats : - baseStats, stats

' --- State
PlayerState <|.. IdleState
PlayerState <|.. MovingState
PlayerState <|.. AttackingState
PlayerState <|.. DodgingState
PlayerState <|.. HurtState
PlayerState <|.. DeadState
PlayerState ..> PlayerStateKind : <<use>>

' --- Template Method
Skill <|-- Shockwave
Skill <|-- BladeFan

' --- Reliques
Relic <|.. AbstractRelic
AbstractRelic <|-- SharpenedBlade
AbstractRelic <|-- AshBoots
AbstractRelic <|-- EmberHeart
AbstractRelic <|-- ShadowFeather
AbstractRelic <|-- HunterEye
AbstractRelic <|-- VampireFang
AbstractRelic <|-- EmberStep
AbstractRelic <|-- Echo
RelicFactory ..> Relic : <<create>>
Relic ..> PlayerStats : <<use>>

note right of PlayerState
  <b>State</b> : le joueur délègue son comportement
  à l'état courant. next() choisit l'état suivant,
  act() agit pendant le pas de temps.
  Plus de if/else géant dans Player : chaque
  état ne connaît que ses propres transitions.
end note

note bottom of Skill
  <b>Template Method</b> : tryActivate() est final
  (vérifie la recharge, appelle activate(), relance
  la recharge) ; chaque compétence n'écrit que
  activate(), son effet propre.
end note

note bottom of RelicFactory
  <b>Factory</b> : draw() tire 3 reliques que le
  joueur n'a pas encore. Run n'écrit jamais
  new SharpenedBlade() : ajouter une relique se
  fait à un seul endroit.
end note

note top of AbstractRelic
  3 niveaux d'héritage :
  Relic → AbstractRelic → SharpenedBlade…
  Les crochets onHit/onAttack/onDodge sont des
  méthodes default vides : une relique ne
  redéfinit que ceux qui la concernent.
end note
@enduml
